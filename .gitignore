# Virtual environments (unslashed to ignore both dirs and .nosync symlinks)
.venv
.venv/
venv/
env/

# Python caches & compiled bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# OS & editor files
.DS_Store
.AppleDouble
.LSOverride
.vscode/
.idea/
*.swp
*.swo

# Testing, linting, type checking & coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# Build & packaging artifacts
dist/
build/
*.egg-info/
.eggs/

# Large local datasets, binaries, training runs & checkpoints
# (unslashed entries ignore both real directories and macOS .nosync symlinks)
data/raw
data/raw/
data/processed
data/processed/
runs
runs/
checkpoints
checkpoints/
bin
bin/

# macOS iCloud Drive .nosync local runtime directories and symlinks
*.nosync
*.nosync/

# Local thesis PDF (preserved locally, excluded from git)
Report_denovo.pdf

# Explicitly keep versioned metadata & benchmark artifacts tracked
!data/metadata/*.csv
!results/figures/*.png
!results/tables/*.json
